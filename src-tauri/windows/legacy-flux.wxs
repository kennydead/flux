<?xml version="1.0" encoding="utf-8"?>
<!-- Flux AI was called "Flux" up to 0.5.8. Tauri's MSI keeps the old product's shortcuts during an
     upgrade (RemoveShortcuts is skipped, since normally the name is the same), so after the rename the
     old "Flux" Start menu folder and desktop shortcut would stay behind, pointing at the removed app.
     Remove them, and give people who had the desktop shortcut a "Flux AI" one. (owner 2026-11-18) -->
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Fragment>
    <Property Id="LEGACYDESKTOPSHORTCUT" Secure="yes">
      <DirectorySearch Id="LegacyDesktopSearch" Path="[DesktopFolder]" Depth="0">
        <FileSearch Id="LegacyDesktopFile" Name="Flux.lnk" />
      </DirectorySearch>
    </Property>

    <DirectoryRef Id="ProgramMenuFolder">
      <Directory Id="LegacyFluxProgramsFolder" Name="Flux">
        <Component Id="RemoveLegacyFluxShortcuts" Guid="9E3A7C1B-4D2F-4B8A-9C61-2F0D5E7A1B34">
          <RemoveFile Id="RemoveLegacyStartMenuLinks" Name="*.lnk" On="install" />
          <RemoveFolder Id="RemoveLegacyFluxProgramsFolder" On="install" />
          <RemoveFile Id="RemoveLegacyDesktopLink" Directory="DesktopFolder" Name="Flux.lnk" On="install" />
          <RegistryValue Root="HKCU" Key="Software\com.claudeagentfarm.flux" Name="LegacyShortcutsRemoved"
                         Type="integer" Value="1" KeyPath="yes" />
        </Component>
      </Directory>
    </DirectoryRef>

    <DirectoryRef Id="DesktopFolder">
      <Component Id="FluxAIDesktopShortcutForLegacy" Guid="3C7B9E52-8A14-4F6D-B2E9-71D04A6C5F18">
        <Condition>LEGACYDESKTOPSHORTCUT</Condition>
        <Shortcut Id="FluxAIDesktopShortcutForLegacy" Name="Flux AI" Description="Runs Flux AI"
                  Target="[!Path]" WorkingDirectory="INSTALLDIR" />
        <RegistryValue Root="HKCU" Key="Software\com.claudeagentfarm.flux" Name="DesktopShortcutMoved"
                       Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </DirectoryRef>
  </Fragment>
</Wix>
